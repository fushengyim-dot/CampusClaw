# 只列变量名；后端当前仅从进程环境读取，不自动加载本文件。
# 网站来源：协议和主机，可带端口，不带末尾斜杠或路径。
APP_ORIGIN=
# 将来Nginx网站入口端口。
WEB_PORT=
# 当前本机Go检查入口端口；留空默认18080，只监听127.0.0.1。
API_PORT=
# 会话密钥；无默认值，不写进代码或版本记录。
SESSION_SECRET=
# 后端连接配置；check-config只校验，check-db及正常启动执行真实连接。
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# 以下变量由后续数据库容器/首次初始化使用，当前后端不读取。
MYSQL_ROOT_PASSWORD=
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A_PASSWORD=
SEED_TEACHER_B_PASSWORD=
SEED_STUDENT_B_PASSWORD=

# 第4课课程AI网关；Compose仅把下列变量传给后端容器，不写进镜像。
# Compose从同目录.env读取这些值并传给API容器；Go本身不解析.env。
# Base URL只到/v1，接口客户端会分别补/embeddings与/chat/completions。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
CHAT_BASE_URL=
# 课程页只提供一把通用密钥时，可留空，Compose会沿用EMBEDDING_API_KEY。
CHAT_API_KEY=
CHAT_MODEL=
